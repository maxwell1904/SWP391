  voucher_maximum_value decimal(22, 2)
  voucher_usage_limit int
  voucher_start_date datetimeoffset(7)
  voucher_end_date datetimeoffset(7)
  voucher_created_at datetimeoffset(7)
  voucher_updated_at datetimeoffset(7)
