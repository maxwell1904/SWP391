}

Table voucher_type {
  voucher_type_id int [pk, not null]
  voucher_type_name nvarchar(255)
}

Table notification {
  notification_id int [pk, not null]
  user_id_sender uniqueidentifier
  notification_title nvarchar(255)
  notification_content nvarchar(max)
  is_notification_draft bit
  notification_created_at datetimeoffset(7)
  notification_updated_at datetimeoffset(7)
}

Table notification_user {
  notification_id int
  user_id uniqueidentifier
  is_notification_viewed bit
  is_notification_deleted bit
}

Table order {
  order_id nvarchar(255) [pk, not null]
