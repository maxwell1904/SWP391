// Generated from migration_full.sql

Table brand {
  brand_id int [pk, not null]
  brand_name nvarchar(255)
  brand_description nvarchar(255)
  brand_image_url nvarchar(255)
  brand_website_url nvarchar(255)
  brand_created_at datetimeoffset(7)
  brand_updated_at datetimeoffset(7)
}

Table cart {
  user_id uniqueidentifier [pk, not null]
  variation_id int [pk, not null]
  cart_quantity int
}

Table category {
  category_id int [pk, not null]
  category_name nvarchar(255)
  category_description nvarchar(max)
  category_image_url nvarchar(255)
  category_created_at datetimeoffset(7)
  category_updated_at datetimeoffset(7)
}

Table color {
  color_id int [pk, not null]
  color_name nvarchar(255)
  color_hex_code nvarchar(255)
}

Table comment {
  comment_id int [pk, not null]
  review_id int
  comment_content nvarchar(255)
  comment_created_at datetimeoffset(7)
  comment_updated_at datetimeoffset(7)
}

Table comment_parent {
  comment_id int
  comment_parent_id int
}

Table voucher {
  voucher_id int [pk, not null]
  voucher_status_id int
  voucher_type_id int
  voucher_code nvarchar(20) [not null]
  voucher_value decimal(22, 2)
