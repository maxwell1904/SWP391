  order_expected_delivery_date datetime2(7)
  order_transaction_reference nvarchar(255)
  order_tax numeric(3, 2)
  order_created_at datetimeoffset(7)
  order_updated_at datetimeoffset(7)
}

Table order_status {
  order_status_id int [pk, not null]
